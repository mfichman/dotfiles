#!/usr/bin/env ruby

require 'optparse'
require 'json'
require 'open3'
#require 'byebug'

def system(*command, exception: true, silent: false)
  $stdout.puts(command.length == 1 ? command.first : command.join(' ')) unless silent
  super(*command, exception: exception)
end

def with_repo_lock
  git_dir = `git rev-parse --git-dir`.strip
  raise "not a git repository" if git_dir.empty? || !$?.success?
  lock_path = File.join(git_dir, 'git-stack.lock')
  lock = File.open(lock_path, File::CREAT | File::RDWR, 0644)
  unless lock.flock(File::LOCK_EX | File::LOCK_NB)
    raise "another git stack operation is in progress (#{lock_path})"
  end
  begin
    yield
  ensure
    lock.flock(File::LOCK_UN)
    lock.close
  end
end

def encode_ref_segment(name)
  name.gsub('%', '%25').gsub('/', '%2F')
end

def stack_ref(parent)
  "refs/git-stack/#{encode_ref_segment(parent)}"
end

def git_stack_notes(commit)
  out, _, status = Open3.capture3('git', 'notes', 'show', commit)
  return [] unless status.success?
  # Tolerate the legacy comma-separated format alongside the newline format.
  out.split(/[,\n]/).map(&:strip).reject(&:empty?).uniq
end

def ensure_notes_rewrite
  out, _, status = Open3.capture3('git', 'config', '--get-all', 'notes.rewriteRef')
  return if status.success? && out.lines.map(&:strip).include?('refs/notes/commits')
  system('git', 'config', '--add', 'notes.rewriteRef', 'refs/notes/commits', silent: true)
end

def git_stack_branches(parent)
  ref = stack_ref(parent)
  sha, _, status = Open3.capture3('git', 'rev-parse', '--verify', '-q', ref)
  return [] unless status.success?
  blob, _, blob_status = Open3.capture3('git', 'cat-file', 'blob', sha.strip)
  return [] unless blob_status.success?
  JSON.parse(blob)
rescue JSON::ParserError
  []
end

def git_stack_branches_write(parent, branches)
  blob_sha, _, status = Open3.capture3(
    'git', 'hash-object', '-w', '--stdin', stdin_data: branches.to_json
  )
  raise "failed to write stack branches blob" unless status.success?
  system('git', 'update-ref', stack_ref(parent), blob_sha.strip, silent: true)
end

# The empty tree object; used as the merge base when cherry-picking a root
# commit (one with no parent). Stack commits always have a parent, so this is
# just a safety fallback.
EMPTY_TREE = '4b825dc642cb6eb9a060e54bf8d69288fbee4904'

# In-memory cherry-pick of `commit` onto `tip`: a 3-way merge with base
# commit^, ours `tip`, theirs `commit`. Touches neither HEAD, the index, nor
# the working tree. Returns [tree_sha, nil] on success or [nil, [files]] on
# conflict (the conflicted tree is written but discarded by the caller).
def git_stack_cherry_pick(tip, commit)
  base, _, st = Open3.capture3('git', 'rev-parse', '--verify', '-q', "#{commit}^")
  base = st.success? ? base.strip : EMPTY_TREE

  out, _, status = Open3.capture3(
    'git', 'merge-tree', '--write-tree', "--merge-base=#{base}", tip, commit
  )
  lines = out.split("\n")
  tree = lines.shift&.strip
  return [tree, nil] if status.success?

  files = lines.map { |l| l[/\t(.+)\z/, 1] }.compact.uniq
  [nil, files]
end

# Create a commit with `tree` and parent `parent`, preserving the author
# (name/email/date) and message of `commit`. Committer defaults to the current
# user/time, matching cherry-pick.
def git_stack_commit_tree(tree, parent, commit)
  meta, _, status = Open3.capture3('git', 'show', '-s', '--format=%an%n%ae%n%aI%n%B', commit)
  raise "failed to read #{commit}" unless status.success?
  name, email, date, *message = meta.split("\n")

  env = { 'GIT_AUTHOR_NAME' => name, 'GIT_AUTHOR_EMAIL' => email, 'GIT_AUTHOR_DATE' => date }
  out, err, status = Open3.capture3(env, 'git', 'commit-tree', tree, '-p', parent, '-m', message.join("\n"))
  raise "commit-tree failed: #{err.strip}" unless status.success?
  out.strip
end

# Rebuild `target` as upstream + `commits` (oldest-first), entirely in the
# object database, then atomically move the ref. Returns nil on success or a
# conflict descriptor on failure (the existing branch is left untouched).
def git_stack_build_branch(target, upstream_sha, commits)
  tip = upstream_sha
  commits.each do |commit|
    tree, conflict_files = git_stack_cherry_pick(tip, commit)
    return { branch: target, commit: commit, files: conflict_files } if conflict_files
    tip = git_stack_commit_tree(tree, tip, commit)
  end
  system('git', 'update-ref', "refs/heads/#{target}", tip, silent: true)
  nil
end

def git_stack_sync
  branch = `git rev-parse --abbrev-ref HEAD`.strip
  upstream_sha = `git rev-parse @{u}`.strip
  commits = `git log --pretty=format:"%H" @{u}..`.split("\n").reject(&:empty?).reverse

  $stdout.puts "Sync branch #{branch}? (Y/N)"
  return if STDIN.gets.strip.upcase != 'Y'

  # Map each linked branch to its commits, in stack (oldest-first) order.
  targets = {}
  commits.each do |commit|
    git_stack_notes(commit).each { |t| (targets[t] ||= []) << commit }
  end

  synced = []
  conflicts = []
  targets.each do |target, target_commits|
    conflict = git_stack_build_branch(target, upstream_sha, target_commits)
    if conflict
      conflicts << conflict
    else
      synced << target
      $stdout.puts "Synced #{target}"
    end
  end

  # Record the branch set (synced now + previously recorded) so `clean` can
  # later prune branches that are no longer linked.
  git_stack_branches_write(branch, (synced + git_stack_branches(branch)).uniq)

  return if conflicts.empty?

  $stderr.puts
  conflicts.each do |c|
    $stderr.puts("\e[31mConflict on #{c[:branch]} applying #{c[:commit][0, 9]}; branch left unchanged\e[0m")
    c[:files].each { |f| $stderr.puts("  #{f}") }
  end
  raise "#{conflicts.length} branch(es) skipped due to conflict"
end

def git_stack_rebase
  branch = `git rev-parse --abbrev-ref HEAD`.strip

  $stdout.puts "Rebase branch #{branch}? (Y/N)"
  return if STDIN.gets.strip.upcase != 'Y'

  system("git stash push -q", exception: true)
  system("git rebase -i @{u} --autosquash", exception: true)
end

def git_stack_push_branch(branch)
  diff, _, status = Open3.capture3('git', 'diff', "origin/#{branch}..#{branch}")

  if status.success? && diff.empty?
    $stdout.puts "No changes for #{branch}"
  else
    unless system('git', 'push', '-fu', 'origin', branch, exception: false)
      $stderr.puts("\e[31mFailed to push #{branch}; skipping\e[0m")
    end
  end
end

def git_stack_push
  commits = `git log --pretty=format:"%h" @{u}..`

  branches = commits.split(/\s+/).flat_map { |commit| git_stack_notes(commit) }

  branches.uniq.each do |branch|
    git_stack_push_branch(branch) if branch != ''
  end
end

def git_stack_clean
  commits = `git log --pretty=format:"%h" @{u}..`
  branch = `git rev-parse --abbrev-ref HEAD`.strip

  stored_branches = git_stack_branches(branch)

  branches = stored_branches.select do |b|
    _, _, status = Open3.capture3('git', 'rev-parse', '--verify', b)
    status.success?
  end

  branches -= commits.split(/\s+/).reverse.flat_map { |commit| git_stack_notes(commit) }

  branches = branches.uniq

  return if branches.empty?

  $stdout.puts branches.join("\n")
  $stdout.puts
  $stdout.puts "Delete these branches? (Y/N)"

  return if STDIN.gets.strip.upcase != 'Y'

  $stdout.puts

  branches.each do |b|
    system('git', 'branch', '-D', b, exception: true, silent: true)
  end

  git_stack_branches_write(branch, stored_branches - branches)
end

def git_stack_log
  format = '%C(brightcyan)%h %C(brightblue)%as%C(bold)% N%C(reset) %s %C(magenta)(%al)%d'
  system("git log --date=relative --color=always -z --pretty=format:'#{format}' @{u}.. | tr '\n' ' ' | tr '\\0' '\n' | less -REXS", silent: true)
end

def resolve_commits(specs)
  commits = []
  specs.each do |spec|
    if spec.include?('..')
      out, _, status = Open3.capture3('git', 'rev-list', spec)
      raise "failed to resolve range #{spec}" unless status.success?
      commits.concat(out.split.reject(&:empty?))
    else
      out, _, status = Open3.capture3('git', 'rev-parse', "#{spec}^{commit}")
      raise "failed to resolve commit #{spec}" unless status.success?
      commits << out.strip
    end
  end
  commits.uniq
end

def git_stack_link
  branch = ARGV.shift
  raise ArgumentError, "usage: git stack link <branch> <commit-or-range>..." if branch.nil? || ARGV.empty?

  resolve_commits(ARGV).each do |commit|
    existing = git_stack_notes(commit)
    next if existing.include?(branch)

    existing << branch
    system('git', 'notes', 'add', '-fm', existing.join("\n"), commit, exception: true)
  end
end

def git_stack_unlink
  branch = ARGV.shift
  raise ArgumentError, "usage: git stack unlink <branch> <commit-or-range>..." if branch.nil? || ARGV.empty?

  resolve_commits(ARGV).each do |commit|
    existing = git_stack_notes(commit)
    next unless existing.include?(branch)

    existing -= [branch]
    if existing.empty?
      system('git', 'notes', 'remove', commit, exception: true)
    else
      system('git', 'notes', 'add', '-fm', existing.join("\n"), commit, exception: true)
    end
  end
end

def global_parser
  OptionParser.new do |o|
    o.banner = 'usage: git stack <command> [args]'
    o.separator ''
    o.separator 'Manage a stack of branches encoded as git notes on commits in @{u}..HEAD.'
    o.separator ''
    o.separator 'Commands:'
    o.separator '  sync                       Cherry-pick each commit onto its linked branch(es), rebuilding them from @{u}.'
    o.separator '  rebase                     Interactive autosquash rebase onto @{u} (applies --fixup/--squash commits).'
    o.separator '  push                       Force-push (origin, -fu) each branch linked from the stack.'
    o.separator '  clean                      Delete local stack branches no longer linked by any commit note.'
    o.separator "  log                        Pretty-print @{u}..HEAD with each commit's linked branches."
    o.separator '  link <branch> <spec>...    Link commit(s) to <branch>. <spec> is a commit or range (a..b).'
    o.separator '  unlink <branch> <spec>...  Unlink commit(s) from <branch>; drops the note when empty.'
    o.separator ''
    o.separator 'Run "git stack <command> --help" for details on a command.'
  end
end

def subcommand_parser(usage, *description)
  OptionParser.new do |o|
    o.banner = "usage: git stack #{usage}"
    o.separator ''
    description.each { |line| o.separator line }
    o.on_tail('-h', '--help', 'Show this help') do
      puts o
      exit
    end
  end
end

SUBCOMMANDS = {
  'sync' => {
    parser: subcommand_parser('sync',
      'Rebuild each linked branch as @{u} plus its linked commits, replayed in',
      'order entirely in the object database -- no checkout, no stash, HEAD is',
      'not moved. Conflicting branches are left unchanged and reported at the',
      'end (sync then exits non-zero). Prompts first. Takes no arguments.'),
    run: -> { with_repo_lock { git_stack_sync } },
  },
  'rebase' => {
    parser: subcommand_parser('rebase',
      'Interactive autosquash rebase onto @{u}, folding --fixup/--squash commits',
      'into their targets. Stashes the working tree and prompts before running.',
      'Takes no arguments.'),
    run: -> { with_repo_lock { git_stack_rebase } },
  },
  'push' => {
    parser: subcommand_parser('push',
      'Force-push (git push -fu origin) each branch linked from commits in',
      '@{u}..HEAD. Branches with no diff against their remote are skipped.',
      'Takes no arguments.'),
    run: -> { with_repo_lock { git_stack_push } },
  },
  'clean' => {
    parser: subcommand_parser('clean',
      'Delete local stack branches that are no longer linked by any commit note.',
      'Lists the branches and prompts before deleting. Takes no arguments.'),
    run: -> { with_repo_lock { git_stack_clean } },
  },
  'log' => {
    parser: subcommand_parser('log',
      "Pretty-print the commits in @{u}..HEAD with each commit's linked branches.",
      'Takes no arguments.'),
    run: -> { git_stack_log },
  },
  'link' => {
    parser: subcommand_parser('link <branch> <commit-or-range>...',
      'Link the given commit(s) to <branch>. Each argument is a single commit or',
      'a range (a..b). A commit may be linked to multiple branches.'),
    run: -> { git_stack_link },
  },
  'unlink' => {
    parser: subcommand_parser('unlink <branch> <commit-or-range>...',
      "Unlink the given commit(s) from <branch>. The commit's note is removed",
      'when its last branch is unlinked.'),
    run: -> { git_stack_unlink },
  },
}.freeze

def main
  if ARGV.empty? || %w[help -h --help].include?(ARGV.first)
    puts global_parser
    return
  end

  command = ARGV.shift
  spec = SUBCOMMANDS[command]
  unless spec
    warn global_parser
    exit 1
  end

  spec[:parser].parse!(ARGV)
  ensure_notes_rewrite
  spec[:run].call
rescue => e
  warn "git: #{e.message}"
  exit 1
end

main
