#!/usr/bin/env python3

import json
import subprocess
import sys
from pathlib import Path


def run(command, check=True, silent=False):
    if not silent:
        print(command)
    result = subprocess.run(command, shell=True)
    if check and result.returncode != 0:
        raise RuntimeError("command failed: {}".format(command))
    return result.returncode == 0


def capture(command):
    result = subprocess.run(
        command, shell=True,
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    )
    return (
        result.stdout.decode("utf-8", errors="replace"),
        result.returncode == 0,
    )


def confirm(prompt):
    print(prompt)
    try:
        return input().strip().upper() == "Y"
    except EOFError:
        return False


def stack_path(branch):
    return Path.home() / ".git-stack" / "branches" / "{}.json".format(branch)


def current_branch():
    out, _ = capture("git rev-parse --abbrev-ref HEAD")
    return out.strip()


def upstream_commits():
    out, _ = capture('git log --pretty=format:"%h" @{u}..')
    return out.split()


def commit_notes(commit):
    out, ok = capture("git notes show {}".format(commit))
    if not ok:
        return []
    return [t for t in out.strip().split(",") if t]


def stored_branches(branch):
    try:
        return json.loads(stack_path(branch).read_text())
    except (OSError, ValueError):
        return []


def write_stored_branches(branch, branches):
    path = stack_path(branch)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(branches))


def unique(seq):
    seen = set()
    out = []
    for item in seq:
        if item not in seen:
            seen.add(item)
            out.append(item)
    return out


def sync_commit(commit, branches):
    targets = commit_notes(commit)
    if not targets:
        return
    for target in targets:
        if target in branches:
            run("git checkout -q {}".format(target))
        else:
            run("git checkout -q @{{u}} -fB {}".format(target))
            branches.append(target)
        run("git cherry-pick {}".format(commit))


def cmd_sync():
    commits = upstream_commits()
    branch = current_branch()

    if not confirm("Sync branch {}? (Y/N)".format(branch)):
        return

    run("git stash push -q")

    branches = []
    for commit in reversed(commits):
        sync_commit(commit, branches)

    branches += stored_branches(branch)

    run("git checkout -q {}".format(branch))

    write_stored_branches(branch, unique(branches))


def cmd_rebase():
    branch = current_branch()

    if not confirm("Rebase branch {}? (Y/N)".format(branch)):
        return

    run("git stash push -q")
    run("git rebase -i @{u} --autosquash")


def push_branch(branch):
    diff, ok = capture("git diff origin/{0}..{0}".format(branch))
    if ok and not diff.strip():
        print("No changes for {}".format(branch))
    else:
        run("git push -fu origin {}".format(branch))


def cmd_push():
    commits = upstream_commits()
    branches = []
    for commit in commits:
        branches.extend(commit_notes(commit))
    for branch in unique(branches):
        if branch:
            push_branch(branch)


def cmd_clean():
    commits = upstream_commits()
    branch = current_branch()

    stored = stored_branches(branch)

    branches = [
        b for b in stored
        if capture("git rev-parse --verify {}".format(b))[1]
    ]

    active = []
    for commit in commits:
        active.extend(commit_notes(commit))
    active_set = set(active)

    branches = unique([b for b in branches if b not in active_set])

    if not branches:
        return

    print("\n".join(branches))
    print()

    if not confirm("Delete these branches? (Y/N)"):
        return

    print()

    for b in branches:
        run("git branch -D {}".format(b), silent=True)

    # Preserves original Ruby behavior: writes to ~/.git-stack-branches.
    remaining = [b for b in stored if b not in branches]
    (Path.home() / ".git-stack-branches").write_text(json.dumps(remaining))


def cmd_log():
    fmt = (
        "%C(brightcyan)%h %C(brightblue)%as%C(bold)% N"
        "%C(reset) %s %C(magenta)(%al)%d"
    )
    command = (
        "git log --date=relative --color=always -z "
        "--pretty=format:'{}' @{{u}}.. "
        "| tr -d '\\n' | tr '\\0' '\\n' | less -REXS"
    ).format(fmt)
    subprocess.run(command, shell=True)


COMMANDS = {
    "sync": cmd_sync,
    "rebase": cmd_rebase,
    "push": cmd_push,
    "clean": cmd_clean,
    "log": cmd_log,
}


def main():
    args = sys.argv[1:]
    command = args[0] if args else None
    try:
        if command not in COMMANDS:
            raise ValueError("usage: git stack sync|rebase|push|clean|log")
        COMMANDS[command]()
    except Exception as e:
        sys.stderr.write("git: {}\n".format(e))
        sys.exit(1)


if __name__ == "__main__":
    main()
